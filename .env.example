# ====================================================================
# doc-bench Environment Configuration
# ====================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: .env is git-ignored. Never commit .env to version control.
# ====================================================================

# ====================================================================
# OPTIONAL: HuggingFace Token
# ====================================================================
# Only required for gated datasets. Most public datasets (OmniDocBench,
# DP-Bench) do not require authentication.
#
# Get your token from: https://huggingface.co/settings/tokens
#
# HF_TOKEN=hf-your-huggingface-token-here

# ====================================================================
# OPTIONAL: doc-bench Log Level
# ====================================================================
# Control logging verbosity for doc-bench operations.
#
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
#
# DOC_BENCH_LOG_LEVEL=INFO

# ====================================================================
# OPTIONAL: doc-bench Output Format
# ====================================================================
# Default output format for evaluation results.
#
# Options: csv, json
# Default: csv
#
# DOC_BENCH_OUTPUT_FORMAT=csv
